{
  "version": 2,
  "functions": {
    "api/vision.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 25
    },
    "api/trending.js": {
      "maxDuration": 25
    },
    "api/check-price.js": {
      "maxDuration": 25
    },
    "api/search.js": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/api/trending",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=1200, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "max-age=1200" }
      ]
    },
    {
      "source": "/api/search",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=600, stale-while-revalidate=7200" }
      ]
    }
  ]
}
